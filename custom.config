process {
    // Configuration globale
    cpus = 4
    memory = '8.GB'
    
    // Configuration spécifique pour le processus problématique
    withName: 'NFCORE_PHASEIMPUTE:PHASEIMPUTE:VCF_NORMALIZE_BCFTOOLS:BCFTOOLS_NORM' {
        cpus = 4
        memory = '12.GB'  // Réduire la mémoire demandée
    }
}