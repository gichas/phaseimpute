nextflow_process {
    name "Test Process IMPUTE5_CONVERTREF"
    script "../main.nf"
    process "IMPUTE5_CONVERTREF"

    tag "impute5/convertref"
    tag "modules"
    tag "modules_nfcore"

    test("Should run without error") {

        when {
            process { 
                """
                input[0] = Channel.of([
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + "delete_me/glimpse/1000GP.chr21.noNA12878.s.bcf", checkIfExists: true),
                    file(params.modules_testdata_base_path + "delete_me/glimpse/1000GP.chr21.noNA12878.s.bcf.csi", checkIfExists: true),
                    "chr21:16600000-16800000"
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.xcf_file[0][1], // le fichier .bcf
                    process.out.xcf_file[0][2], // le fichier .csi  
                    process.out.xcf_file[0][3], // le fichier .bin
                    process.out.xcf_file[0][4], // le fichier .fam
                    process.out.versions
                ).match("convertref_basic") }
            )
        }
    }

    test("impute5-convertref-stub") {
        options '-stub'
        
        when {
            process { 
                """
                input[0] = Channel.of([
                    [ id:'test' ],
                    file('dummy.bcf'),
                    file('dummy.bcf.csi'),
                    "chr21"
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.xcf_file[0][1],  // fichier .bcf stub
                    process.out.xcf_file[0][2],  // fichier .csi stub
                    process.out.xcf_file[0][3],  // fichier .bin stub
                    process.out.xcf_file[0][4],  // fichier .fam stub
                    process.out.versions          // versions.yml stub
                ).match("convertref_stub") }
            )
        }
    }
}
  