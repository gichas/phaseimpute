nextflow_process {
    name "Test Process IMPUTE5_IMPUTE"
    script "../main.nf"
    process "IMPUTE5_IMPUTE"

    tag "impute5/impute"
    tag "modules"
    tag "modules_nfcore"

    test("Should run without error") {
        setup {
            run("IMPUTE5_CONVERTREF") {
                script "../../convertref/main.nf"
                process {
                """
                input[0] = Channel.of([
                    [ id:'ref_data' ],
                    file(params.modules_testdata_base_path + "delete_me/glimpse/1000GP.chr21.noNA12878.s.bcf", checkIfExists: true),
                    file(params.modules_testdata_base_path + "delete_me/glimpse/1000GP.chr21.noNA12878.s.bcf.csi", checkIfExists: true),
                    "chr21:16600000-16800000"
                ])
                """
                }
            }
        }

        when {
            process {
                """
                input[0] = IMPUTE5_CONVERTREF.out.xcf_file
                    .map { meta, xcf_bcf, xcf_csi, xcf_bin, xcf_fam ->
                        [
                            [ id:'test_impute' ],
                            file(params.modules_testdata_base_path + "delete_me/glimpse/NA12878.chr21.s.1x.vcf.gz", checkIfExists: true),
                            file(params.modules_testdata_base_path + "delete_me/glimpse/NA12878.chr21.s.1x.vcf.gz.csi", checkIfExists: true),
                            xcf_bcf,
                            xcf_csi,
                            xcf_bin,
                            xcf_fam,
                            file(params.modules_testdata_base_path + "delete_me/glimpse/chr21.b38.gmap.gz", checkIfExists: true),
                            "chr21:16600000-16700000"  // Région plus petite pour la stabilité
                        ]
                    }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    file(process.out.bcf[0][1]).name,
                    file(process.out.log[0][1]).name,
                    process.out.versions
                ).match("impute_basic") }
            )
        }
    }

    test("impute5-impute-without-region") {
        setup {
            run("IMPUTE5_CONVERTREF") {
                script "../../convertref/main.nf"
                process {
                """
                input[0] = Channel.of([
                    [ id:'ref_no_region' ],
                    file(params.modules_testdata_base_path + "delete_me/glimpse/1000GP.chr21.noNA12878.s.bcf", checkIfExists: true),
                    file(params.modules_testdata_base_path + "delete_me/glimpse/1000GP.chr21.noNA12878.s.bcf.csi", checkIfExists: true),
                    "chr21"
                ])
                """
                }
            }
        }

        when {
            process {
                """
                input[0] = IMPUTE5_CONVERTREF.out.xcf_file
                    .map { meta, xcf_bcf, xcf_csi, xcf_bin, xcf_fam ->
                        [
                            [ id:'test_no_region' ],
                            file(params.modules_testdata_base_path + "delete_me/glimpse/NA12878.chr21.s.1x.vcf.gz", checkIfExists: true),
                            file(params.modules_testdata_base_path + "delete_me/glimpse/NA12878.chr21.s.1x.vcf.gz.csi", checkIfExists: true),
                            xcf_bcf,
                            xcf_csi,
                            xcf_bin,
                            xcf_fam,
                            file(params.modules_testdata_base_path + "delete_me/glimpse/chr21.b38.gmap.gz", checkIfExists: true),
                            ""  // Pas de région spécifique
                        ]
                    }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    file(process.out.bcf[0][1]).name,
                    file(process.out.log[0][1]).name,
                    process.out.versions
                ).match("impute_no_region") }
            )
        }
    }

    test("impute5-impute-stub") {
        options '-stub'

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id:'test_stub' ],
                    file('stub_target.bcf'),
                    file('stub_target.bcf.csi'),
                    file('stub_ref.xcf'),
                    file('stub_ref.xcf.csi'),
                    file('stub_ref.bin'),
                    file('stub_ref.fam'),
                    file('stub_genetic_map.gmap.gz'),
                    'chr21:16600000-16700000'
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    file(process.out.bcf[0][1]).name,
                    file(process.out.log[0][1]).name,
                    process.out.versions
                ).match("impute_stub") }
            )
        }
    }
}