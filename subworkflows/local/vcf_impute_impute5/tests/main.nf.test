nextflow_workflow {

    name "Test Subworkflow VCF_IMPUTE_IMPUTE5"
    script "../main.nf"
    config "./nextflow.config"

    workflow "VCF_IMPUTE_IMPUTE5"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "subworkflows/vcf_impute_impute5"
    tag "vcf_impute_impute5"

    tag "impute5"
    tag "impute5/chunk"
    tag "impute5/convertref"
    tag "impute5/impute"

    test("Impute one vcf") {
        tag "one_vcf"
        when {
            workflow {
                """
                // Target data - fichier à imputer
                input[0] = Channel.of([
                    [id: "NA12878", panel: "1000GP", chr: "22"],
                    file(params.pipelines_testdata_base_path + "hum_data/individuals/NA12878/NA12878.s.bcf", checkIfExists: true),
                    file(params.pipelines_testdata_base_path + "hum_data/individuals/NA12878/NA12878.s.bcf.csi", checkIfExists: true),
                    "chr22:16500000-16700000"
                ])

                // Reference panel data
                input[1] = Channel.of([
                    [id: "1000GP", chr: "22"],
                    file(params.pipelines_testdata_base_path + "hum_data/panel/chr22/1000GP.chr22.s.norel.vcf.gz", checkIfExists: true),
                    file(params.pipelines_testdata_base_path + "hum_data/panel/chr22/1000GP.chr22.s.norel.vcf.gz.csi", checkIfExists: true),
                    "chr22:16500000-16700000"
                ])

                // Genetic map data
                input[2] = Channel.of([
                    [id: "1000GP", chr: "22"],
                    file(params.pipelines_testdata_base_path + "hum_data/reference_genome/GRCh38_22.map", checkIfExists: true),
                    "chr22:16500000-16700000"
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.versions,
                    workflow.out.imputed_bcf.collect( entry ->
                        [entry[0], path(entry[1]).getFileName().toString()]
                    ).sort(),
                    workflow.out.imputed_log.collect( entry ->
                        [entry[0], path(entry[1]).getFileName().toString()]
                    ).sort(),
                    workflow.out.chunks.collect( entry ->
                        [entry[0], path(entry[1]).getFileName().toString()]
                    ),
                    workflow.out.xcf_files.collect( entry ->
                        [
                            entry[0],
                            path(entry[1]).getFileName().toString(), 
                            path(entry[2]).getFileName().toString(),  
                            path(entry[3]).getFileName().toString(),  
                            path(entry[4]).getFileName().toString()   
                        ]
                    )
                ).match() }
            )
        }

    }
    

    test("Impute with IMPUTE5 - stub") {

        tag "stub"

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [id: "test_stub", panel: "stub", chr: "21"],
                    file('stub_target.bcf'),
                    file('stub_target.bcf.csi'),
                    "chr21"
                ])

                input[1] = Channel.of([
                    [id: "stub_panel", chr: "21"],
                    file('stub_reference.bcf'),
                    file('stub_reference.bcf.csi'),
                    "chr21"
                ])

                input[2] = Channel.of([
                    [id: "stub_panel", chr: "21"],
                    file('stub_genetic.gmap.gz'),
                    "chr21"
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }

test("Impute with IMPUTE5 - backup data") {
    tag "backup"
    
    when {
        workflow {
            """
            // input[0] = ch_input: Channel.fromList pour multiple samples si besoin
            input[0] = Channel.of([
                [id: "test_backup", chr: "20"],
                file("/home/gichas/impute5_backup_complet/modules_impute5/impute/tests/testdata/target.bcf", checkIfExists: true),
                file("/home/gichas/impute5_backup_complet/modules_impute5/impute/tests/testdata/target.bcf.csi", checkIfExists: true)
            ])
            
            // input[1] = ch_panel: avec .collect() comme dans l'exemple
            input[1] = Channel.of([
                [id: "ref_backup", chr: "20"],
                file("/home/gichas/impute5_backup_complet/modules_impute5/impute/tests/testdata/reference.bcf", checkIfExists: true),
                file("/home/gichas/impute5_backup_complet/modules_impute5/impute/tests/testdata/reference.bcf.csi", checkIfExists: true)
            ]).collect()
            
            // input[2] = ch_map: structure simple comme dans l'exemple
            input[2] = Channel.of([
                [chr: "20"],
                file("/home/gichas/impute5_backup_complet/modules_impute5/impute/tests/testdata/chr20.b37.gmap.gz", checkIfExists: true)
            ])
            """
        }
    }
    
    then {
        assertAll(
            { assert workflow.success },
            { assert workflow.out.vcf_tbi.size() >= 1 },
            { assert snapshot(
                workflow.out.versions,
                workflow.out.vcf_tbi.collect{[
                    it[0],
                    path(it[1]).getFileName().toString()
                ] }
            ).match() }
        )
    }
}

}