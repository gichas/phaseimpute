nextflow_workflow {

    name "Test Subworkflow VCF_IMPUTE_IMPUTE5"
    script "../main.nf"
    config "./nextflow.config"

    workflow "VCF_IMPUTE_IMPUTE5"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "subworkflows/vcf_impute_impute5"
    tag "vcf_impute_impute5"

    tag "impute5"
    tag "impute5/chunk"
    tag "impute5/convertref"
    tag "impute5/impute"

