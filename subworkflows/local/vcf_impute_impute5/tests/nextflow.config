params {
    chunk_args = "--window-size 200000 --buffer-size 10000"
    convertref_args = ''
    convertref_maf = 0.03125
    convertref_threads = 2
    impute_args = ''
    impute_buffer_size = 250000

    }

process {

    resourceLimits = [
        cpus: 4,
        memory: '8.GB',
        time: '24.h'
    ]

    withName: 'IMPUTE5_CHUNK' {
        ext.args = { params.chunk_args }
        cpus = 2
        memory = '4.GB'
        time = '2.h'
        publishDir = [ enabled: false ]
    }

    withName: 'IMPUTE5_CONVERTREF' {
        ext.args = { params.convertref_args }
        ext.prefix = { meta.id }
        ext.maf = { params.convertref_maf }
        ext.threads = { params.convertref_threads }
        cpus = { params.convertref_threads }
        memory = '6.GB'
        time = '4.h'
        publishDir = [ enabled: false ]
    }

    withName: 'IMPUTE5_IMPUTE' {
        ext.args = { params.impute_args }
        ext.prefix = { meta.chunk_id ? "${meta.id}_chunk${meta.chunk_id}" : meta.id }  // <- AJOUTER CETTE LIGNE
        ext.buffer_size = { params.impute_buffer_size }
        cpus = 4
        memory = '6.GB'
        time = '24.h'
        publishDir = [
            path: { "${params.outdir}/imputed" },
            mode: 'copy',
            pattern: "*_imputed.{bcf,log}"
        ]
    }

    withName: 'BCFTOOLS_INDEX' {
        cpus = 1
        memory = '2.GB'
        time = '1.h'
    }
    withName: 'BCFTOOLS_CONCAT' {
        ext.args = "--output-type z --write-index=csi"
        cpus = 1
        memory = '2.GB'
        time = '1.h'
    }
}
